<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Lab Test type -->
  <record id="hms_test_view" model="ir.ui.view">
    <field name="name">Laboratory Test</field>
    <field name="model">tgr.lab.test</field>
    <field name="arch" type="xml">
      <form string="Análisis">
        <sheet>
          <widget bg_color="bg-danger" invisible="active" name="web_ribbon"
            title="Archivado"></widget>
          <group>
            <group>
              <field name="name" required="1"></field>
              <field
                context="{'default_detailed_type': 'service', 'default_hospital_product_type': 'pathology'}"
                domain="[('type','=','service'), ('hospital_product_type', 'in', ['pathology'])]"
                name="product_id"></field>
              <field name="list_price"></field>
              <field name="sample_type_id"></field>
            </group>
            <group>
              <field name="code"></field>
              <field name="tgr_tat"></field>
              <field name="result_value_type"></field>
              <field name="area_id"></field>
            </group>
          </group>
          <notebook>
            <page name="diagnosis" string="Diagnóstico">
              <field colspan="2"
                context="{'default_result_value_type': result_value_type}"
                name="critearea_ids" nolabel="1"
                widget="section_and_note_one2many">
                <list editable="bottom" string="Casos de Prueba">
                  <control>
                    <create string="Agregar una línea"></create>
                    <create context="{'default_display_type': 'line_section'}"
                      string="Agregar una sección"></create>
                  </control>
                  <field name="sequence" widget="handle"></field>
                  <field name="name" required="1" widget="section_and_note"></field>
                  <field name="minimum_range" required="not display_type"></field>
                  <field name="maximum_range" required="not display_type"></field>
                  <field name="lab_uom_id"></field>
                  <field name="result_value_type"></field>
                  <field name="remark"></field>
                  <field column_invisible="1" name="display_type"></field>
                </list>
              </field>
            </page>
            <page name="consumable_lines" string="Material Consumido">
              <field colspan="2" name="consumable_line_ids" nolabel="1">
                <list editable="top" string="Línea">
                  <field expand="1" name="product_id" required="1"></field>
                  <field groups="uom.group_uom" name="product_uom_id"
                    required="1"></field>
                  <field name="qty" required="1"></field>
                  <field column_invisible="1" name="tracking"></field>
                  <field column_invisible="1" name="product_uom_category_id"></field>
                  <field column_invisible="1" name="move_id"></field>
                </list>
              </field>
            </page>
            <page name="other_info" string="Otra Información">
              <group>
                <group>
                  <field name="subsequent_test_ids" widget="many2many_tags"></field>
                </group>
                <group>
                  <field name="tgr_use_other_test_sample"></field>
                  <field groups="base.group_multi_company" name="company_id"
                    options="{'no_create': True}"></field>
                  <field invisible="1" name="active"></field>
                </group>
              </group>
            </page>
          </notebook>
          <field name="description" placeholder="Descripción"></field>
        </sheet>
      </form>
    </field>
  </record>
  <record id="hms_test_tree" model="ir.ui.view">
    <field name="name">Lab Tests</field>
    <field name="model">tgr.lab.test</field>
    <field name="arch" type="xml">
      <list string="Análisis">
        <field name="name"></field>
        <field name="code"></field>
        <field name="list_price"></field>
        <field invisible="1" name="active"></field>
      </list>
    </field>
  </record>
  <record id="hms_action_form_test" model="ir.actions.act_window">
    <field name="name">Análisis</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.lab.test</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No se encontraron registros</p>
      <p>Haga clic para agregar un nuevo Análisis.</p>
    </field>
  </record>
</odoo>
