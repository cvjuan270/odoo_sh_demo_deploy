<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista de formulario para áreas de laboratorio -->
  <record id="view_laboratory_area_form" model="ir.ui.view">
    <field name="name">laboratory.area.form</field>
    <field name="model">laboratory.area</field>
    <field name="arch" type="xml">
      <form string="Area de Laboratorio">
        <sheet>
          <field invisible="1" name="color" widget="color_picker"></field>
          <div class="oe_title">
            <label class="oe_edit_only" for="name"></label>
            <h1>
              <field name="name" placeholder="Nombre del área..."></field>
            </h1>
          </div>
          <group>
            <group>
              <field name="code"></field>
              <field name="sequence"></field>
            </group>
            <group></group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <!-- Vista de árbol para áreas de laboratorio -->
  <record id="view_laboratory_area_tree" model="ir.ui.view">
    <field name="name">laboratory.area.tree</field>
    <field name="model">laboratory.area</field>
    <field name="arch" type="xml">
      <list multi_edit="1" sample="1" string="Laboratory Areas">
        <field name="sequence" widget="handle"></field>
        <field name="code"></field>
        <field name="name"></field>
      </list>
    </field>
  </record>
  <!-- Vista kanban para áreas de laboratorio -->
  <record id="view_laboratory_area_kanban" model="ir.ui.view">
    <field name="name">laboratory.area.kanban</field>
    <field name="model">laboratory.area</field>
    <field name="arch" type="xml">
      <kanban class="o_laboratory_area_kanban" sample="1">
        <field name="id"></field>
        <field name="name"></field>
        <field name="code"></field>
        <field name="color"></field>
        <templates>
          <t t-name="card">
            <div
              t-attf-class="oe_kanban_global_click oe_kanban_card oe_kanban_content o_kanban_record_has_image_fill o_laboratory_area_kanban"
              t-attf-style="background-color:#{kanban_color(record.color.raw_value)}">
              <div class="o_kanban_record_top mb16">
                <div class="o_kanban_record_headings">
                  <strong class="o_kanban_record_title">
                    <span>
                      <t t-esc="record.name.value"></t>
                    </span>
                  </strong>
                  <small class="o_kanban_record_subtitle text-muted">
                    <t t-esc="record.code.value"></t>
                  </small>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <!-- Vista de búsqueda para áreas de laboratorio -->
  <record id="view_laboratory_area_search" model="ir.ui.view">
    <field name="name">laboratory.area.search</field>
    <field name="model">laboratory.area</field>
    <field name="arch" type="xml">
      <search string="Buscar Area de Laboratorio">
        <field name="name" string="Area"></field>
        <field name="code"></field>
      </search>
    </field>
  </record>
  <!-- Acción para abrir áreas de laboratorio -->
  <record id="action_laboratory_area" model="ir.actions.act_window">
    <field name="name">Area de Laboratorio</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">laboratory.area</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea tu primera área de
        laboratorio</p>
      <p>Organiza tus estudios de laboratorio por áreas especializadas para un
        mejor seguimiento y gestión.</p>
    </field>
  </record>
</odoo>
