<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!--Patient Test
  Results-->
  <record id="patient_laboratory_test_view" model="ir.ui.view">
    <field name="name">Laboratory Test</field>
    <field name="model">patient.laboratory.test</field>
    <field name="arch" type="xml">
      <form string="Análisis de Laboratorio">
        <header>
          <button class="oe_highlight" invisible="state!='draft'"
            name="action_done" string="Finalizado" type="object"></button>
          <button invisible="state=='draft'" name="action_cancel"
            string="Cancelar" type="object"></button>
          <button class="oe_highlight"
            invisible="state not in ['done','cancel']" name="action_draft"
            string="Borrador" type="object"></button>
          <button invisible="state not in ['draft','done']"
            name="action_lab_test_send" string="Enviar por Correo" type="object"></button>
          <field name="state" statusbar_visible="draft,done" widget="statusbar"></field>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" icon="fa-files-o"
              name="action_view_attachments" type="object">
              <field name="attach_count" string="Documentos" widget="statinfo"></field>
            </button>
            <button class="oe_stat_button" icon="fa-list"
              invisible="not sample_ids" name="action_view_lab_samples"
              string="Muestras" type="object"></button>
          </div>
          <h1>
            <field class="oe_inline" name="name"></field>
          </h1>
          <group>
            <group>
              <field name="patient_id" readonly="state!='draft'"></field>
              <field name="test_id" readonly="state!='draft'" required="1"></field>
              <field name="physician_id" readonly="state!='draft'"></field>
              <field
                domain="[('request_id','=',request_id),('patient_id','=',patient_id)]"
                name="sample_ids" options="{'no_create': True}"
                readonly="state!='draft'" widget="many2many_tags"></field>
              <field name="area_id"></field>
            </group>
            <group>
              <field name="user_id" readonly="state!='draft'" required="1"></field>
              <field name="lab_physician_id" readonly="state!='draft'"></field>
              <field name="date_requested" readonly="state!='draft'"></field>
              <field name="date_analysis" readonly="state!='draft'"></field>
            </group>
          </group>
          <notebook>
            <page name="diagnosis" string="Diagnóstico">
              <field colspan="2" name="critearea_ids" nolabel="1"
                readonly="state in ['done','cancel']"
                widget="section_and_note_one2many">
                <list decoration-danger="result_type in ['low','high','danger']"
                  decoration-warning="result_type=='warning'" editable="bottom"
                  string="Casos de Prueba">
                  <control>
                    <create string="Agregar una línea"></create>
                    <create context="{'default_display_type': 'line_section'}"
                      string="Agregar una sección"></create>
                  </control>
                  <field name="sequence" widget="handle"></field>
                  <field name="name" required="1" widget="section_and_note"></field>
                  <field name="minimum_range" readonly="1"></field>
                  <field name="maximum_range" readonly="1"></field>
                  <field name="lab_uom_id"></field>
                  <field name="result"></field>
                  <field name="result_type"></field>
                  <field name="remark"></field>
                  <field column_invisible="1" name="display_type"></field>
                </list>
              </field>
            </page>
            <page name="consumed_material" string="Material Consumido">
              <field colspan="2"
                context="{'default_patient_id': patient_id, 'default_physician_id': lab_physician_id}"
                name="consumable_line_ids" nolabel="1"
                readonly="state in ['done','cancel']">
                <list editable="top" string="Línea">
                  <field name="product_id" required="1"></field>
                  <field groups="uom.group_uom" name="product_uom_id"
                    required="1"></field>
                  <field name="qty" required="1"></field>
                  <field context="{'tgr_product_id': product_id}" name="lot_id"
                    options="{'no_create': True}" readonly="tracking=='none'"
                    required="tracking!='none'"></field>
                  <field name="date" required="1"></field>
                  <field force_save="1" name="price_unit" readonly="1"></field>
                  <field name="subtotal" optional="show" readonly="1"
                    sum="Total"></field>
                  <field column_invisible="1" name="tracking"></field>
                  <field column_invisible="1" name="product_uom_category_id"></field>
                  <field column_invisible="1" name="pricelist_id"></field>
                  <field column_invisible="1" name="move_id"></field>
                  <field column_invisible="1" name="physician_id"></field>
                </list>
              </field>
            </page>
            <page name="other_info" string="Otra Información">
              <group>
                <group>
                  <field domain="[('patient_id','=',patient_id)]"
                    name="request_id" readonly="state!='draft'"></field>
                  <field name="parent_test_id" readonly="state!='draft'"></field>
                  <field domain=" [('is_collection_center', '=', False)]"
                    invisible="not laboratory_id" name="laboratory_id"
                    readonly="state!='draft'"></field>
                </group>
                <group>
                  <field domain=" [('is_collection_center', '=', True)]"
                    name="collection_center_id" readonly="state!='draft'"></field>
                  <field groups="base.group_multi_company" name="company_id"
                    options="{'no_create': True}" readonly="state!='draft'"></field>
                </group>
              </group>
            </page>
          </notebook>
          <field name="diagnosis" placeholder="Diagnóstico"
            readonly="state in ['done','cancel']"></field>
          <field name="note" placeholder="Nota Extra"
            readonly="state in ['done','cancel']"></field>
          <field colspan="2" name="disclaimer" nolabel="1"
            placeholder="Descargo de Responsabilidad" readonly="state in ['done','cancel']"></field>
        </sheet>
        <chatter></chatter>
      </form>
    </field>
  </record>
  <record id="patient_laboratory_test_tree" model="ir.ui.view">
    <field name="name">Laboratory Test</field>
    <field name="model">patient.laboratory.test</field>
    <field name="arch" type="xml">
      <list string="Análisis">
        <field name="name"></field>
        <field name="test_id"></field>
        <field name="patient_id"></field>
        <field name="date_analysis"></field>
        <field groups="base.group_multi_company" name="company_id"></field>
        <field decoration-danger="state=='cancel'"
          decoration-info="state=='draft'" decoration-success="state=='done'"
          name="state" widget="badge"></field>
      </list>
    </field>
  </record>
  <record id="view_hms_patient_laboratory_test_search" model="ir.ui.view">
    <field name="name">patient.laboratory.test.search</field>
    <field name="model">patient.laboratory.test</field>
    <field name="arch" type="xml">
      <search string="Resultados de Análisis del Paciente">
        <field name="name"></field>
        <field name="test_id"></field>
        <field name="patient_id"></field>
        <field name="date_analysis"></field>
        <group expand="0" string="Agrupar Por">
          <filter context="{'group_by':'patient_id'}" name="group_by_patient_id"
            string="Paciente"></filter>
          <filter context="{'group_by':'request_id'}" name="group_by_lab_test"
            string="Solicitud de Laboratorio"></filter>
          <filter context="{'group_by':'test_id'}" name="group_by_test"
            string="Test"></filter>
          <filter context="{'group_by':'user_id'}" name="group_by_user"
            string="Analizado Por"></filter>
          <filter context="{'group_by':'physician_id'}" name="group_by_req"
            string="Médico Prescriptor"></filter>
          <filter context="{'group_by':'state'}" name="group_by_state"
            string="Estado"></filter>
        </group>
      </search>
    </field>
  </record>
  <record id="view_patient_laboratory_test_calendar" model="ir.ui.view">
    <field name="name">patient.laboratory.test.calendar</field>
    <field name="model">patient.laboratory.test</field>
    <field name="type">calendar</field>
    <field name="arch" type="xml">
      <calendar color="physician_id" date_start="date_requested"
        string="Análisis del Paciente">
        <field name="physician_id"></field>
        <field name="patient_id"></field>
        <field name="state"></field>
      </calendar>
    </field>
  </record>
  <record id="patient_laboratory_test_pivot" model="ir.ui.view">
    <field name="name">patient.laboratory.test.pivot</field>
    <field name="model">patient.laboratory.test</field>
    <field name="arch" type="xml">
      <pivot string="Análisis del Paciente">
        <field name="date_analysis" type="row"></field>
        <field name="physician_id" type="row"></field>
        <field name="patient_id" type="row"></field>
      </pivot>
    </field>
  </record>
  <record id="action_lab_result" model="ir.actions.act_window">
    <field name="name">Resultados de Análisis</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">patient.laboratory.test</field>
    <field name="view_mode">list,form,calendar,pivot</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No se encontraron registros</p>
      <p>Haga clic para agregar un nuevo Resultado de Análisis.</p>
    </field>
  </record>
</odoo>
