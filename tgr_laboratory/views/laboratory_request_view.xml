<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="patient_laboratory_test_request_form" model="ir.ui.view">
    <field name="name">Test Requests</field>
    <field name="model">tgr.laboratory.request</field>
    <field name="arch" type="xml">
      <form string="Solicitudes de Laboratorio">
        <header>
          <button class="oe_highlight" invisible="state!='draft'"
            name="button_requested" string="Enviar Solicitud" type="object"></button>
          <button class="oe_highlight"
            groups="tgr_laboratory.group_hms_lab_user"
            invisible="state!='requested'" name="button_accept" string="Aceptar"
            type="object"></button>
          <button class="oe_highlight"
            groups="tgr_laboratory.group_hms_lab_user"
            invisible="state!='accepted'" name="button_in_progress"
            string="En Progreso" type="object"></button>
          <button class="oe_highlight"
            groups="tgr_laboratory.group_hms_lab_user"
            invisible="state!='in_progress'" name="button_done" string="Finalizado"
            type="object"></button>
          <button class="oe_highlight" groups="account.group_account_invoice"
            invisible="not tgr_show_create_invoice" name="create_invoice"
            string="Crear Factura" type="object"></button>
          <button groups="tgr_laboratory.group_hms_lab_user"
            invisible="state not in ['requested','accepted','in_progress']"
            name="button_cancel" string="Cancelar" type="object"></button>
          <button groups="tgr_laboratory.group_hms_lab_user"
            invisible="state!='cancel'" name="button_draft"
            string="Restablecer a Borrador" type="object"></button>
          <field name="state"
            statusbar_visible="draft,requested,accepted,in_progress,done"
            widget="statusbar"></field>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button"
              groups="account.group_account_invoice" icon="fa-money"
              invisible="not invoice_id" name="view_invoice" type="object">
              <field name="invoice_count" string="Facturas" widget="statinfo"></field>
            </button>
            <button class="oe_stat_button" icon="fa-flask"
              invisible="state not in ['in_progress','to_invoice','done']"
              name="action_view_test_results" string="Resultados de Prueba"
              type="object"></button>
            <button class="oe_stat_button" icon="fa-list"
              name="action_view_lab_samples" string="Muestras" type="object"></button>
          </div>
          <h1>
            <field class="oe_inline" name="name"></field>
          </h1>
          <group>
            <group>
              <field name="patient_id" readonly="state!='draft'"></field>
              <field name="patient_age" readonly="state!='draft'"></field>
              <field name="date" readonly="state!='draft'"></field>
              <field name="physician_id" readonly="state!='draft'"></field>
              <field name="profile_ids" widget="many2many_tags"
                readonly="state not in ['draft','requested']"></field>
              <field name="is_group_request" readonly="state!='draft'"></field>
              <field invisible="not is_group_request" name="group_patient_ids"
                readonly="state!='draft'" required="is_group_request"
                widget="many2many_tags"></field>
              <field invisible="1" name="tgr_show_create_invoice"></field>
            </group>
            <group>
              <field domain="[('is_collection_center','=',True)]"
                groups="tgr_laboratory.group_manage_collection_center"
                name="collection_center_id" readonly="state!='draft'"></field>
              <field name="other_laboratory"
                readonly="state in ['done','cancel']"></field>
              <field invisible="not other_laboratory" name="laboratory_id"
                readonly="state in ['done','cancel']"
                required="other_laboratory"></field>
              <button class="oe_link" icon="fa-envelope"
                invisible="not other_laboratory" name="action_sendmail"
                string="Enviar correo" type="object"></button>
              <button class="oe_link" groups="account.group_account_invoice"
                icon="fa-money" invisible="not other_laboratory or lab_bill_id"
                name="create_laboratory_bill" string="Crear Factura de Compra" type="object"></button>
            </group>
          </group>
          <notebook>
            <page name="lines" string="Líneas">
              <group>
                <field context="{'default_display_type': 'line', }"
                  name="line_ids" widget="section_and_note_one2many"
                  readonly="state not in ['draft','requested']">
                  <list editable="bottom" string="Líneas">
                    <control>
                      <create name="add_line_control" string="Agregar Linea"></create>
                      <create context="{'default_display_type': 'line_section'}"
                        name="add_section_control" string="Agregar sección"></create>
                      <create context="{'default_display_type': 'line_note'}"
                        name="add_note_control" string="Agregar Nota"></create>
                    </control>
                    <field invisible="1" name="display_type"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))], 'required': [('display_type', '=', 'line')]}"
                      name="test_id" string="Test"></field>
                    <field
                      attrs="{'required': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      name="name" widget="section_and_note_text"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      name="tgr_tat" optional="show"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      force_save="1" name="sale_price" readonly="not is_manager"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      column_invisible="not parent.is_group_request"
                      name="quantity"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      name="instruction"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      column_invisible="not parent.is_group_request"
                      name="amount_total"></field>
                    <field invisible="1" name="is_manager"></field>
                    <field
                      attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"
                      name="profile_id"></field>
                  </list>
                </field>
                <group class="oe_subtotal_footer oe_right">
                  <field name="total_price"></field>
                </group>
              </group>
            </page>
            <page name="other_info" string="Otra Información">
              <group>
                <group>
                  <label for="invoice_exempt"></label>
                  <div name="invoice_exemption">
                    <field class="oe_inline" name="invoice_exempt" nolabel="1"
                      readonly="1"></field>
                    <button class="oe_inline fa fa-arrow-right oe_link"
                      groups="tgr_hms_base.group_tgr_invoice_exemption"
                      invisible="invoice_id" name="tgr_apply_invoice_exemption"
                      string="Aplicar/Eliminar" type="object"></button>
                  </div>
                  <field invisible="1" name="invoice_id"></field>
                  <field invisible="1" name="tgr_laboratory_invoice_policy"></field>
                  <field invisible="1" name="payment_state"></field>
                </group>
                <group>
                  <field groups="account.group_account_invoice"
                    invisible="not other_laboratory or lab_bill_id"
                    name="lab_bill_id" readonly="1"></field>
                  <label for="pricelist_id"
                    groups="product.group_product_pricelist"></label>
                  <div groups="product.group_product_pricelist"
                    name="pricelist_id">
                    <field class="oe_inline" name="pricelist_id"
                      options="{'no_open':True, 'no_create': True}"
                      readonly="state!='draft'"></field>
                    <button class="oe_inline fa fa-arrow-right oe_link"
                      invisible="not pricelist_id" name="tgr_update_price"
                      string="Actualizar Precio" type="object"></button>
                  </div>
                  <field groups="base.group_multi_company" name="company_id"
                    options="{'no_create': True}" readonly="state!='draft'"></field>
                  <field invisible="1" name="company_id"></field>
                </group>
              </group>
            </page>
          </notebook>
          <field colspan="2" name="notes" nolabel="1" placeholder="Notas"
            readonly="state!='draft'"></field>
        </sheet>
        <chatter></chatter>
      </form>
    </field>
  </record>
  <record id="patient_laboratory_test_request_tree" model="ir.ui.view">
    <field name="name">Test Requests</field>
    <field name="model">tgr.laboratory.request</field>
    <field name="arch" type="xml">
      <list decoration-danger="state=='waiting'"
        decoration-info="state=='draft'" decoration-muted="state=='cancel'"
        name="request_tree" string="Solicitudes de Análisis">
        <field name="name"></field>
        <field name="patient_id"></field>
        <field name="date"></field>
        <field name="physician_id"></field>
        <field name="activity_ids" optional="show" widget="list_activity"></field>
        <field groups="base.group_multi_company" name="company_id"></field>
        <field decoration-danger="state=='cancel'"
          decoration-info="state=='draft'" decoration-it="state=='accepted'"
          decoration-muted="state=='to_invoice'"
          decoration-primary="state=='in_progress'"
          decoration-success="state=='done'"
          decoration-warning="state=='requested'" name="state" string="Estado"
          widget="badge"></field>
      </list>
    </field>
  </record>
  <record id="view_tgr_laboratory_request_search" model="ir.ui.view">
    <field name="name">tgr.laboratory.request.search</field>
    <field name="model">tgr.laboratory.request</field>
    <field name="arch" type="xml">
      <search string="Análisis del Paciente">
        <field name="name"></field>
        <field name="patient_id"></field>
        <field name="physician_id"></field>
        <filter domain="[('state','=','in_progress')]" name="in_progress"
          string="En Progreso"></filter>
        <filter domain="[('state','=','draft')]" name="draft" string="Borrador"></filter>
        <filter domain="[('state','=','done')]" name="done" string="Finalizado"></filter>
        <filter domain="[('state','=','invoiced')]" name="invoiced"
          string="Facturado"></filter>
        <filter domain="[('state','=','invoice_exempt')]" name="invoice_exempt"
          string="Exento de Factura"></filter>
        <separator></separator>
        <group expand="0" string="Agrupar Por">
          <filter context="{'group_by':'patient_id'}" name="group_by_patient_id"
            string="Paciente"></filter>
          <filter context="{'group_by':'date'}" name="group_by_date"
            string="Fecha"></filter>
          <filter context="{'group_by':'physician_id'}"
            name="group_by_physician" string="Médico"></filter>
          <filter context="{'group_by':'collection_center_id'}"
            name="group_by_collection_center" string="Centro de Recolección"></filter>
          <filter context="{'group_by':'company_id'}" name="group_by_company"
            string="Institución"></filter>
          <filter context="{'group_by':'state'}" name="group_by_state"
            string="Estado"></filter>
        </group>
      </search>
    </field>
  </record>
  <record id="view_tgr_laboratory_request_calendar" model="ir.ui.view">
    <field name="name">tgr.laboratory.request.calendar</field>
    <field name="model">tgr.laboratory.request</field>
    <field name="type">calendar</field>
    <field name="arch" type="xml">
      <calendar color="physician_id" date_start="date" string="Análisis del Paciente">
        <field name="physician_id"></field>
        <field name="patient_id"></field>
        <field name="state"></field>
      </calendar>
    </field>
  </record>
  <record id="tgr_laboratory_request_pivot" model="ir.ui.view">
    <field name="name">tgr.laboratory.request.pivot</field>
    <field name="model">tgr.laboratory.request</field>
    <field name="arch" type="xml">
      <pivot string="Análisis del Paciente">
        <field name="date" type="row"></field>
        <field name="physician_id" type="row"></field>
        <field name="patient_id" type="row"></field>
      </pivot>
    </field>
  </record>
  <record id="hms_action_lab_test_request" model="ir.actions.act_window">
    <field name="name">Solicitudes de Laboratorio</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.laboratory.request</field>
    <field name="view_mode">list,form,calendar,pivot</field>
    <field name="context">{'search_default_in_progress': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No se encontraron registros</p>
      <p>Haga clic para agregar una nueva Solicitud de Laboratorio.</p>
    </field>
  </record>
  <!-- Laboratory Request Group -->
  <record id="view_laboratory_group_tree" model="ir.ui.view">
    <field name="name">laboratory.group.tree</field>
    <field name="model">laboratory.group</field>
    <field name="arch" type="xml">
      <list string="Línea">
        <field name="name"></field>
      </list>
    </field>
  </record>
  <record id="view_laboratory_group_form" model="ir.ui.view">
    <field name="name">laboratory.group.form</field>
    <field name="model">laboratory.group</field>
    <field name="arch" type="xml">
      <form string="Perfil de Laboratorio">
        <sheet>
          <div class="oe_title">
            <label class="oe_edit_only" for="name" string="Nombre"></label>
            <h1>
              <field name="name" placeholder="Nombre del Perfil"></field>
            </h1>
          </div>
          <group></group>
          <field name="line_ids">
            <list editable="bottom" string="Líneas">
              <field name="test_id" string="Test"></field>
              <field name="tgr_tat" optional="show"></field>
              <field name="sale_price"></field>
              <field name="instruction"></field>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_laboratory_group" model="ir.actions.act_window">
    <field name="name">Perfil de Laboratorio</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">laboratory.group</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No hay registros</p>
      <p>Click en Nuevo para crear un nuevo Perfil de Laboratorio</p>
    </field>
  </record>
</odoo>
