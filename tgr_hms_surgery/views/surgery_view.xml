<?xml version="1.0"?>
<odoo>
  <record id="hms_surgery_view" model="ir.ui.view">
    <field name="name">Cirugía</field>
    <field name="model">hms.surgery</field>
    <field name="arch" type="xml">
      <form string="Cirugía">
        <header>
          <button name="action_confirm" string="Confirmar" class="oe_highlight"
            type="object" invisible="state!='draft'"
            groups="tgr_hms_surgery.group_tgr_hms_surgery_approver" />
          <button name="action_done" string="Hecho" invisible="state!='confirm'"
            type="object" class="oe_highlight"
            groups="tgr_hms_surgery.group_tgr_hms_surgery_approver" />
          <button name="action_cancel" string="Cancelar"
            invisible="state!='confirm'" type="object" class="oe_highlight"
            groups="tgr_hms_surgery.group_tgr_hms_surgery_approver" />
          <button name="action_draft" string="Borrador" invisible="state!='cancel'"
            type="object" class="oe_highlight"
            groups="tgr_hms_surgery.group_tgr_hms_surgery_approver" />
          <button name="action_create_invoice" string="Crear Factura"
            groups="account.group_account_invoice"
            invisible="invoice_id or invoice_exempt" type="object"
            class="oe_highlight" />
          <field name="state" widget="statusbar"
            statusbar_visible="draft,confirm,done" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object"
              name="action_prescription" title="Prescripción"
              icon="fa-pencil-square-o" string="Prescripción" widget="statinfo" />
            <button type="object" class="oe_stat_button" icon="fa-money"
              name="view_invoice" groups="account.group_account_invoice">
              <field string="Facturas" name="invoice_count" widget="statinfo" />
            </button>
          </div>
          <h1>
            <field name="name" readonly="1" class="oe_inline" />
          </h1>
          <group>
            <group>
              <field name="patient_id" required="1"
                readonly="state in ['cancel','done']" />
              <field name="age" invisible="1" />
              <field name="diseases_ids" widget="many2many_tags"
                readonly="state in ['cancel','done']" />
              <field name="surgery_name" required="1"
                readonly="state in ['cancel','done']" />
            </group>
            <group>
              <label for="start_date" string="Fecha" />
              <div class="o_row">
                <field name="start_date" widget="daterange" nolabel="1"
                  class="oe_inline" options="{'related_end_date': 'end_date'}"
                  readonly="state in ['cancel','done']" />
                <i class="fa fa-long-arrow-right mx-2" aria-label="Arrow icon"
                  title="Arrow" />
                <field name="end_date" widget="daterange" nolabel="1"
                  class="oe_inline"
                  options="{'related_start_date': 'start_date'}"
                  readonly="state in ['cancel','done']" />
              </div>
              <field name="invoice_id" invisible="1" />
              <field name="state" invisible="1" />
              <field name='invoice_exempt' invisible="1" />
            </group>
          </group>
          <notebook groups="tgr_hms.group_hms_nurse">
            <page string="Información General" name="general">
              <group>
                <group string="Detalles de la Plantilla">
                  <field name="surgery_template_id"
                    readonly="state in ['cancel','done']" />
                  <field name="surgery_product_id"
                    domain="[('hospital_product_type','=','surgery')]"
                    context="{'default_hospital_product_type':'surgery'}"
                    readonly="state in ['cancel','done']" />
                </group>
                <group string="Detalles del Cirujano">
                  <field name="primary_physician_id" required="1"
                    readonly="state in ['cancel','done']" />
                  <field name="primary_physician_ids" widget="many2many_tags"
                    domain="[('is_primary_surgeon', '=', True)]"
                    readonly="state in ['cancel','done']" />
                  <field name="assisting_surgeon_ids" widget="many2many_tags"
                    readonly="state in ['cancel','done']" />
                </group>
              </group>
              <group>
                <group string="Otros Detalles">
                  <field name="scrub_nurse_id"
                    readonly="state in ['cancel','done']" />
                  <field name="appointment_id"
                    readonly="state in ['cancel','done']" />
                  <field name="treatment_id"
                    readonly="state in ['cancel','done']" />
                  <field name="department_id"
                    readonly="state in ['cancel','done']" />
                  <label for="invoice_exempt" />
                  <div name='invoice_exemption'>
                    <field name='invoice_exempt' class="oe_inline" nolabel="1"
                      readonly="1" />
                    <button name="tgr_apply_invoice_exemption"
                      string="Aplicar/Eliminar" type="object"
                      class="oe_inline fa fa-arrow-right oe_link"
                      invisible="invoice_id"
                      groups="tgr_hms_base.group_tgr_invoice_exemption" />
                  </div>
                </group>
                <group string="Detalles de Anestesia">
                  <field name="anesthetist_id"
                    readonly="state in ['cancel','done']" />
                  <field name="anesthesia_id"
                    readonly="state in ['cancel','done']" />
                </group>
              </group>
            </page>
            <page name="pre_operative_checklist"
              string="Lista de Verificación Preoperatoria"
              groups="tgr_hms.group_hms_nurse,tgr_hms.group_hms_medical_officer">
              <div class="oe_right mt16" name="check_progress">
                <field name="pre_operative_checklist_done" widget="percentpie"
                  string="Verificado" readonly="state in ['cancel','done']" />
              </div>
              <field name="pre_operative_checklist_ids"
                readonly="state in ['cancel','done']">
                <list editable="top">
                  <field name="name" />
                  <field name="is_done" />
                  <field name="remark" />
                </list>
              </field>
            </page>
            <page name="medication" string="Medicación">
              <group string="Consumibles">
                <field name="consumable_line_ids" nolabel="1" colspan="2"
                  context="{'default_patient_id': patient_id, 'default_department_id': department_id, 'default_physician_id': primary_physician_id}"
                  readonly="state in ['cancel','done']">
                  <list string="Línea" editable="top">
                    <field name="product_id" required="1"
                      context="{'default_hospital_product_type':'medicament'}" />
                    <field name="product_uom_id" required="1"
                      groups="uom.group_uom" />
                    <field name="qty" required="1" />
                    <field name="lot_id"
                      context="{'tgr_product_id': product_id}"
                      options="{'no_create': True}" readonly="tracking=='none'"
                      required="tracking!='none'" />
                    <field name="price_unit" readonly="1" force_save="1" />
                    <field name="subtotal" readonly="1" sum="Total"
                      optional="show" />
                    <field name="tracking" column_invisible="1" />
                    <field name="product_uom_category_id" column_invisible="1" />
                    <field name="pricelist_id" column_invisible="1" />
                    <field name="move_id" column_invisible="1" />
                    <field name="physician_id" optional="show" />
                    <field name="department_id" column_invisible="1" />
                    <field name="patient_id" column_invisible="1" />
                  </list>
                </field>
              </group>
              <group string="Plan de Medicación">
                <button name="button_pres_request" string="Crear Prescripción"
                  type="object" class="oe_highlight"
                  groups="tgr_hms_surgery.group_tgr_hms_surgery_approver" />
                <field name="medicament_line_ids" nolabel="1" colspan="2"
                  readonly="state in ['cancel','done']">
                  <list string="Línea" editable="top">
                    <field name="product_id" expand="1" required="1" />
                    <field name="active_component_ids" widget="many2many_tags" />
                    <field name="form_id" />
                    <field name="dose" />
                    <field name="days" />
                    <field name="medicine_uom_id" required="1"
                      string="Unidad de Dosificación" />
                    <field name="product_uom_category_id" column_invisible="1" />
                    <field name="common_dosage_id" />
                    <field name="product_uom_category_id" column_invisible="1" />
                    <field name="qty" required="1" string="Unidades" />
                    <field name="instruction" />
                  </list>
                </field>
              </group>
              <group string="Precauciones Especiales" />
              <field name="special_precautions" colspan='4'
                readonly="state in ['cancel','done']" />
              <group string="Información Extra" />
              <field name="extra_info" colspan='4'
                readonly="state in ['cancel','done']" />
            </page>
            <page name="post_oprative" string="Órdenes Postoperatorias"
              groups="tgr_hms.group_hms_medical_officer">
              <group string="Instrucción General">
                <field name="post_instruction" nolabel="1" colspan="2"
                  readonly="state in ['cancel','done']" />
              </group>
              <group string="Precaución Especial">
                <field name="special_precautions" nolabel="1" colspan="2"
                  readonly="state in ['cancel','done']" />
              </group>
            </page>
            <page name="discharge_summary" string="Resumen de Alta">
              <group string="Diagnóstico" />
              <field name="diagnosis" colspan="2"
                readonly="state in ['cancel','done']" />
              <group string="Historia Clínica" />
              <field name="clinincal_history" colspan="2"
                readonly="state in ['cancel','done']" />
              <group string="Examen" />
              <field name="examination" colspan="2"
                readonly="state in ['cancel','done']" />
              <group string="Investigaciones" />
              <field name="investigation" colspan="2"
                readonly="state in ['cancel','done']" />
              <group string="Consejos al dar de alta" />
              <field name="adv_on_dis" colspan="2"
                readonly="state in ['cancel','done']" />
            </page>
          </notebook>
          <field name="notes" colspan="2" placeholder="Notas Operatorias"
            readonly="state in ['cancel','done']" />
        </sheet>
        <chatter></chatter>
      </form>
    </field>
  </record>
  <record id="view_tgr_surgery_filter" model="ir.ui.view">
    <field name="name">Surgery</field>
    <field name="model">hms.surgery</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search string="Buscar Cirugía">
        <field name="name" />
        <field name="surgery_name" />
        <field name="patient_id" />
        <field name="primary_physician_id" />
        <field name="assisting_surgeon_ids" />
        <field name="scrub_nurse_id" />
        <field name="anesthetist_id" />
        <field name="treatment_id" />
        <separator />
        <filter string="Borrador" name="draft" domain="[('state','=','draft')]" />
        <filter string="Confirmado" name="confirmed"
          domain="[('state','=','confirm')]" />
        <filter string="Hecho" name="done" domain="[('state','=','done')]" />
        <group expand="0" string="Agrupar por">
          <filter name="group_by_anesthesia" string="Anestesia"
            context="{'group_by':'anesthesia_id'}" />
          <filter name="group_by_surgery_poduct" string="Producto de Cirugía"
            context="{'group_by':'surgery_product_id'}" />
          <filter string="Paciente" name="patient_groupby" domain="[]"
            context="{'group_by':'patient_id'}" />
          <filter string="Estado" name="state_groupby" domain="[]"
            context="{'group_by':'state'}" />
          <filter string="Enfermedad" name="disease_groupby" domain="[]"
            context="{'group_by':'diseases_ids'}" />
        </group>
      </search>
    </field>
  </record>
  <record id="hms_surgery_tree" model="ir.ui.view">
    <field name="name">Listas de Cirugía</field>
    <field name="model">hms.surgery</field>
    <field name="arch" type="xml">
      <list string='Cirugía'>
        <field name="name" />
        <field name="patient_id" />
        <field name="surgery_name" />
        <field name="age" />
        <field name="start_date" />
        <field name="diseases_ids" widget="many2many_tags" />
        <field name="state" decoration-info="state=='draft'"
          decoration-danger="state=='cancel'" decoration-success="state=='done'"
          decoration-warning="state=='confirm'" widget="badge" />
      </list>
    </field>
  </record>
  <record id="hms_surgery_calendar" model="ir.ui.view">
    <field name="name">hms.surgery.calendar</field>
    <field name="model">hms.surgery</field>
    <field name="arch" type="xml">
      <calendar date_start="start_date" date_stop="end_date"
        color="surgery_template_id" quick_create="0" string="Cirugía">
        <field name="surgery_name" />
        <field name="primary_physician_id" />
        <field name="primary_physician_ids" />
        <field name="assisting_surgeon_ids" widget="many2many_tags" />
        <field name="anesthetist_id" />
        <field name="patient_id" />
        <field name="state" filters="1" />
        <field name="primary_physician_id" avatar_field="image_128" />
      </calendar>
    </field>
  </record>
  <record id="action_hms_surgery" model="ir.actions.act_window">
    <field name="name">Cirugía</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hms.surgery</field>
    <field name="view_mode">list,calendar,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> Haga clic para añadir una nueva Cirugía. </p>
    </field>
  </record>
</odoo>
