<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_ward_tree" model="ir.ui.view">
    <field name="name">ward.tree</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <list string="Árbol de Salas" decoration-success="state=='available'"
        decoration-danger="state=='full'">
        <field name="name" />
        <field name="ward_room_type" />
        <field name="bed_count" />
        <field name="building_id" />
        <field name="telephone" />
        <field name="department_id" groups="tgr_hms.group_allow_multi_department" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="view_ward_form" model="ir.ui.view">
    <field name="name">ward.form</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <form string="Formulario de Sala">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" name="action_bed"
              context="{'search_default_ward': id,'default_ward': id}" icon="fa-bed" type="object">
              <div class="o_field_widget o_stat_info">
                <span class="o_stat_value" widget="statinfo">
                  <field name="bed_available_count" widget="statinfo" nolabel="1" class="mr4" />/ <field
                    name="bed_count" />
                </span>
                <span class="o_stat_text">Camas Disponibles</span>
              </div>
            </button>
          </div>
          <group>
            <group>
              <field name="name" />
              <field name="floor" />
              <field name="ward_room_type" />
              <field name="state" required="True" />
              <field name="department_id" groups="tgr_hms.group_allow_multi_department" />
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company" />
              <field name="building_id" />
              <field name="private" />
              <field name="gender" />
            </group>
          </group>
          <notebook>
            <page name="facility" string="Instalaciones">
              <group>
                <group>
                  <field name="internet" />
                  <field name="air_conditioning" />
                  <field name="private_bathroom" />
                  <field name="television" />
                  <field name="telephone" />
                </group>
                <group>
                  <field name="guest_sofa" />
                  <field name="microwave" />
                  <field name="bio_hazard" />
                  <field name="refrigerator" />
                </group>
              </group>
            </page>
          </notebook>
          <field name="notes" nolabel="1" placeholder="Notas..." />
        </sheet>
      </form>
    </field>
  </record>

  <record id="ward_search" model="ir.ui.view">
    <field name="name">ward.search</field>
    <field name="model">hospital.ward</field>
    <field name="arch" type="xml">
      <search string="Búsqueda de Salas">
        <field name="name" />
        <field name="floor" />
        <field name="building_id" />
        <filter name="private" string="Privado" domain="[('private','=',1)]" />
        <filter name="available" string="Habitaciones Disponibles" domain="[('state','=','available')]" />
        <filter name="full" string="Habitaciones Llenas" domain="[('state','=','full')]" />
        <newline />
        <group expand="0" string="Agrupar Por...">
          <filter name="group_by_building" string="Edificio" domain="[]"
            context="{'group_by':'building_id'}" />
          <filter name="group_by_type" string="Agrupar Por Sala/Habitación"
            context="{'group_by':'ward_room_type'}" />
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="actions_ward">
    <field name="name">Sala/Habitación de Hospital</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hospital.ward</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="ward_search" />
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Haga clic para agregar una Sala/Habitación.
      </p>
    </field>
  </record>
</odoo>
