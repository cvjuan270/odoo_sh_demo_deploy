<?xml version="1.0"?>
<odoo>
  <record id="view_tgr_hospitalization_form" model="ir.ui.view">
    <field name="name">tgr.hospitalization.form</field>
    <field name="model">tgr.hospitalization</field>
    <field name="arch" type="xml">
      <form string="Información de Registro de Paciente Interno">
        <header>
          <button name="action_confirm" string="Confirmar" class="oe_highlight" type="object"
            invisible="state!='draft'"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
          <button name="action_hospitalize" string="Hospitalizar" class="oe_highlight" type="object"
            invisible="state!='confirm' or allow_bed_reservation"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
          <button name="action_hospitalize" string="Hospitalizar" class="oe_highlight" type="object"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive"
            invisible="state!='confirm' or not allow_bed_reservation" />
          <button name="action_reserve" type="object" string="Reservar" class="oe_highlight"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive"
            invisible="state!='confirm' or not allow_bed_reservation" />
          <button name="action_discharge" type="object" string="Dar de Alta" class="oe_highlight"
            invisible="state!='hosp'"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
          <button name="action_cancel" string="Cancelar"
            invisible="state not in ('reserved','confirm')" type="object" class="oe_highlight"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
          <button name="action_create_invoice" string="Crear Factura" class="oe_highlight"
            type="object" invisible="state!='discharged' or invoice_exempt"
            groups="account.group_account_invoice" />
          <button name="button_indoor_medication" string="Solicitud de Medicamento IP" type="object"
            invisible="state!='hosp'" class="oe_highlight" groups="tgr_hms.group_hms_jr_doctor" />
          <button name="action_done" string="Realizado" type="object" class="oe_highlight"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive,tgr_hms.group_hms_medical_officer"
            invisible="state!='discharged' or invoice_count==0 or invoice_exempt" />
          <button name="action_done" string="Realizado" type="object" class="oe_highlight"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive,tgr_hms.group_hms_medical_officer"
            invisible="state!='discharged' or not invoice_exempt" />
          <button name="action_draft" string="Borrador" invisible="state!='cancel'" type="object"
            class="oe_highlight"
            groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
          <field name="state" widget="statusbar"
            statusbar_visible="draft,confirm,hosp,discharged,done" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button type="object" class="oe_stat_button" icon="fa-money" name="tgr_invoice_forecast"
              invisible="state not in ['hosp','discharged']" groups="account.group_account_invoice"
              string="Pronóstico de Factura" />
            <button type="object" class="oe_stat_button" icon="fa-pencil-square-o"
              name="view_invoice" invisible="state not in ['hosp','discharged','done']"
              groups="account.group_account_invoice">
              <field string="Facturas" name="invoice_count" widget="statinfo" />
            </button>
            <button type="object" class="oe_stat_button" icon="fa-stethoscope"
              name="action_view_procedures">
              <field string="Procedimiento" name="procedure_count" widget="statinfo" />
            </button>
            <button type="object" class="oe_stat_button" icon="fa-bed" name="action_view_surgery">
              <field string="Cirugía" name="surgery_count" widget="statinfo" />
            </button>
            <button name="action_prescription" class="oe_stat_button" icon="fa-wpforms"
              type="object" invisible="state not in ['confirm','hosp','discharged','done']">
              <field string="Solicitudes IPM" name="prescription_count" widget="statinfo" />
            </button>
            <button type="object" class="oe_stat_button" icon="fa-bed"
              name="action_accommodation_history"
              groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive">
              <field string="Asignación de Cama" name="accommodation_count" widget="statinfo" />
            </button>
            <button type="object" class="oe_stat_button" icon="fa-stethoscope"
              name="action_view_evaluation">
              <field string="Evaluaciones" name="evaluation_count" widget="statinfo" />
            </button>
          </div>
          <field name="image_128" widget='image' class="oe_avatar" />
          <h1>
            <label for="name" string="Hospitalización #" invisible="state!='draft'" />
            <field name="name" readonly="1" class="oe_inline" invisible="state=='draft'" />
          </h1>

          <group>
            <group>
              <field name="patient_id" required="1"
                readonly="state in ['hosp','discharge','cancel','done']" />
              <field name="physician_id" required="1"
                readonly="state in ['discharge','cancel','done']" />
              <field name="attending_physician_ids" widget="many2many_tags"
                readonly="state in ['discharge','cancel','done']" />
              <field name="diseases_ids" widget="many2many_tags"
                readonly="state in ['discharge','cancel','done']" />
            </group>
            <group>
              <field name="hospitalization_date" required="1"
                readonly="state in ['hosp','discharge','cancel','done']" />
              <field name="discharge_date" readonly="state in ['cancel','done']" />
              <field name="department_id" groups="tgr_hms.group_allow_multi_department"
                readonly="state in ['hosp','discharge','cancel','done']" />
              <!-- Invisible Fields -->
              <field name="invoice_count" invisible="1" />
              <field name="department_id" invisible="1" />
            </group>
          </group>

          <notebook name="main">
            <page name="general" string="Información General">
              <group>
                <group>
                  <field name="relative_id" readonly="state in ['discharge','cancel','done']" />
                  <field name="relative_number" readonly="state in ['discharge','cancel','done']" />
                  <field name="appointment_id" invisible="1" />
                  <field name="ref_physician_id" domain="[('is_referring_doctor','=',True)]"
                    readonly="state in ['discharge','cancel','done']" />
                  <label for="invoice_exempt" />
                  <div name='invoice_exemption'>
                    <field name='invoice_exempt' class="oe_inline" nolabel="1" readonly="1" />
                    <button name="tgr_apply_invoice_exemption" string="Aplicar/Eliminar"
                      type="object"
                      class="oe_inline fa fa-arrow-right oe_link" invisible="state=='done'"
                      groups="tgr_hms_base.group_tgr_invoice_exemption" />
                  </div>
                </group>
                <group>
                  <field name="allow_bed_reservation" invisible="1" />
                  <field name="ward_id" widget="selection" required="state=='confirm'"
                    readonly="state in ['hosp','discharge','cancel','done']" />
                  <label for="bed_id" />
                  <div name='bed_id'>
                    <field name='bed_id' class="oe_inline" nolabel="1"
                      domain="[('ward_id', '=', ward_id), ('state', '=', 'free')]"
                      required="state=='confirm'" widget="selection"
                      readonly="state in ['hosp','discharge','cancel','done']" />
                    <button name="%(transfer_accommodation_action)d" string="Transferir"
                      class="oe_inline fa fa-exchange oe_link" type='action'
                      invisible="state not in ['reserved','hosp']"
                      groups="tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive" />
                  </div>
                  <field name="admission_type" required="1"
                    readonly="state in ['hosp','discharge','cancel','done']" />
                  <field name="company_id" required="1" groups="base.group_multi_company"
                    options="{'no_create': True}"
                    readonly="state in ['hosp','discharge','cancel','done']" />
                  <field name="pricelist_id" groups="product.group_product_pricelist"
                    options="{'no_open':True,'no_create': True}"
                    readonly="state in ['cancel','done']" />
                  <field name="company_id" invisible="1" />
                </group>
              </group>

            </page>
            <page name="hospitalization_checklist" string="Lista de Verificación"
              groups="tgr_hms.group_hms_nurse,tgr_hms_hospitalization.group_tgr_hms_hospitalization_executive">
              <separator string="Lista de Verificación de Admisión" />
              <div class="oe_right mt16" name="check_progress">
                <field name="checklist_done" widget="percentpie" string="Verificado" />
              </div>
              <field name="checklist_ids" readonly="state in ['hosp','discharge','cancel','done']">
                <list editable="top">
                  <field name="name" />
                  <field name="is_done" />
                  <field name="remark" />
                </list>
              </field>

              <separator string="Lista de Verificación Pre-Sala" />
              <div class="oe_right mt16" name="pre_operative_check_progress">
                <field name="pre_ward_checklist_done" widget="percentpie" string="Verificado" />
              </div>
              <field name="pre_ward_checklist_ids" readonly="state in ['discharge','cancel','done']">
                <list editable="top">
                  <field name="name" />
                  <field name="is_done" />
                  <field name="remark" />
                </list>
              </field>
            </page>

            <page name="clinical_ass" string="Evaluación Clínica"
              groups="tgr_hms.group_hms_nurse,tgr_hms_hospitalization.group_tgr_hms_hospitalization_user">
              <div>NOTA: Los detalles se muestran basados en la última Evaluación de Paciente
                Completada: <t
                  invisible="not last_evaluation_id">
                  <field name="last_evaluation_id" nolabel="1" class="oe_link" />
                </t><t
                  invisible="state=='done'">
                  <button name="action_create_evaluation" type="object" string="Crear Evaluación"
                    class=" oe_link" />
                </t></div>

              <group>
                <group>
                  <label for="weight" />
                  <div class="o_row">
                    <field name="weight" />
                    <field name="tgr_weight_name" />
                  </div>
                  <label for="height" />
                  <div class="o_row">
                    <field name="height" />
                    <field name="tgr_height_name" />
                  </div>
                  <label for="temp" />
                  <div class="o_row">
                    <field name="temp" />
                    <field name="tgr_temp_name" />
                  </div>
                </group>
                <group>
                  <field name="rr" />
                  <label string="PA Sistólica/Diastólica" for="systolic_bp" />
                  <div name="systolic_bp">
                    <div class="oe_inline" style="display: inline;">
                      <field name="systolic_bp" class="oe_inline" />/<field name="diastolic_bp"
                        class="oe_inline" />
                    </div>
                  </div>
                  <label for="spo2" />
                  <div class="o_row">
                    <field name="spo2" />
                    <field name="tgr_spo2_name" />
                  </div>
                  <label for="rbs" />
                  <div class="o_row">
                    <field name="rbs" />
                    <field name="tgr_rbs_name" />
                  </div>
                </group>
                <group>
                  <field name="bmi" />
                </group>
                <group>
                  <field name="bmi_state" />
                </group>
              </group>
              <separator string="Nivel de Dolor" />
              <group>
                <group>
                  <label for="pain_level" />
                  <div class="o_row">
                    <field name="pain_level" />
                    <span>
                      <button name="%(tgr_hms.action_tgr_pain_level)d" type="action"
                        icon="fa-question-circle" title="Nivel de Dolor" />
                    </span>
                  </div>
                  <field name="pain" colspan="2" nolabel="1" />
                </group>
              </group>
            </page>

            <!-- Start Basic Care Plan -->
            <page name="basic_careplan" string="Plan de Cuidados"
              groups="tgr_hms.group_hms_medical_officer,tgr_hms.group_hms_nurse,tgr_hms_hospitalization.group_tgr_hms_hospitalization_user"
              invisible="state not in ['hosp','discharged','done']">
              <group>
                <group>
                  <field name="nurse_id" readonly="state in ['discharge','cancel','done']" />
                </group>
                <group>
                  <field name="care_plan_template_id"
                    readonly="state in ['discharge','cancel','done']" />
                </group>
              </group>
              <label for="nursing_plan" />
              <field name="nursing_plan" colspan="4"
                readonly="state in ['discharge','cancel','done']" />
              <group string="Rondas Médicas en Sala" name="physician_ward_rounds">
                <field name="physician_ward_round_ids" nolabel="1" colspan="2"
                  readonly="state in ['discharge','cancel','done']">
                  <list string="Línea" editable="top">
                    <field name="date" />
                    <field name="instruction" required="1" />
                    <field name="physician_id" required="1" />
                    <field name="remarks" required="1" />
                    <field name="prescription_ids" column_invisible="1" />
                    <button name="tgr_create_ip_medicine_request"
                      title="Crear Solicitud de Medicamento IP"
                      type="object" icon="fa-wpforms" width="0.1"
                      invisible="parent.state in ['done','cancel']" />
                    <button name="action_prescriptions" title="Ver Recetas" type="object"
                      icon="fa-list" width="0.1" invisible="not prescription_ids" />
                  </list>
                </field>
              </group>
            </page>
            <page name="consumable_lines" string="Productos/Servicios Consumidos"
              invisible="state not in ['hosp','discharged','done']"
              groups="tgr_hms.group_hms_medical_officer,tgr_hms.group_hms_nurse,tgr_hms_hospitalization.group_tgr_hms_hospitalization_user">
              <field name="consumable_line_ids" nolabel="1" colspan="2"
                context="{'default_patient_id': patient_id, 'default_department_id': department_id, 'default_physician_id': physician_id}"
                readonly="state in ['cancel','done']">
                <list string="Línea" editable="top">
                  <field name="product_id" expand="1" required="1" />
                  <field name="product_uom_id" required="1" groups="uom.group_uom" />
                  <field name="qty" required="1" />
                  <field name="lot_id" context="{'tgr_product_id': product_id}"
                    options="{'no_create': True}" readonly="tracking=='none'"
                    required="tracking!='none'" />
                  <field name="price_unit" readonly="1" force_save="1" />
                  <field name="subtotal" readonly="1" sum="Total" optional="show" />
                  <field name="date" required="1" />
                  <field name="tracking" column_invisible="1" />
                  <field name="product_uom_category_id" column_invisible="1" />
                  <field name="pricelist_id" column_invisible="1" />
                  <field name="move_id" column_invisible="1" />
                  <field name="physician_id" optional="show" />
                  <field name="department_id" column_invisible="1" />
                  <field name="patient_id" column_invisible="1" />
                </list>
              </field>
            </page>
            <page string="Resumen de Alta"
              groups="tgr_hms.group_hms_jr_doctor,tgr_hms.group_hms_medical_officer,tgr_hms_hospitalization.group_tgr_hms_hospitalization_user"
              name="discharged" invisible="state not in ['hosp','discharged','done']">
              <group>
                <group>
                  <field name="death_register_id" readonly="state in ['cancel','done']" />
                </group>
              </group>
              <separator string="Diagnóstico de Alta" />
              <field name="discharge_diagnosis" readonly="state in ['cancel','done']" />
              <separator string="Nota Preoperatoria" />
              <field name="op_note" readonly="state in ['cancel','done']" />
              <separator string="Curso Postoperatorio" />
              <field name="post_operative" readonly="state in ['cancel','done']" />
              <separator string="Plan de Alta" />
              <field name="discharge_plan" readonly="state in ['cancel','done']" />
              <separator string="Instrucciones" />
              <field name="instructions" readonly="state in ['cancel','done']" />
            </page>
            <page name="legal_data" string="Detalles Legales"
              groups="tgr_hms.group_hms_medical_officer">
              <group>
                <field name="legal_case" />
              </group>
              <group>
                <field name="reported_to_police" widget="radio"
                  readonly="state in ['cancel','done']" />
                <field name="fir_no" invisible="reported_to_police!='yes'"
                  readonly="state in ['cancel','done']" />
                <field name="fir_reason" invisible="reported_to_police!='no'"
                  readonly="state in ['cancel','done']" />
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter></chatter>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="tgr_hospitalization_tree">
    <field name="name">tgr.hospitalization.tree</field>
    <field name="model">tgr.hospitalization</field>
    <field name="arch" type="xml">
      <list string="Info de Registro de Paciente Interno">
        <field name="name"></field>
        <field name="patient_id"></field>
        <field name="hospitalization_date"></field>
        <field name="discharge_date"></field>
        <field name="ward_id" />
        <field name="bed_id"></field>
        <field name="activity_ids" widget="list_activity" optional="show" />
        <field name="state" decoration-info="state=='draft'" decoration-muted="state=='hosp'"
          decoration-danger="state=='cancel'" decoration-success="state=='done'"
          decoration-primary="state=='reserved'" decoration-warning="state=='confirm'"
          decoration-it="state=='discharged'" widget="badge" />
        <field name="company_id" groups="base.group_multi_company" />
      </list>
    </field>
  </record>

  <record id="view_tgr_hospitalization_filter" model="ir.ui.view">
    <field name="name">tgr.hospitalization.select</field>
    <field name="model">tgr.hospitalization</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search string="Buscar Hospitalizaciones">
        <filter name="draft" string="Borrador" domain="[('state','=','draft')]" />
        <filter name="reserved" string="Reservado" domain="[('state','=','reserved')]" />
        <filter name="hospitalize" string="Hospitalizado" domain="[('state','=','hosp')]" />
        <filter name="discharged" string="Dado de Alta" domain="[('state','=','discharged')]" />
        <filter name="done" string="Realizado" domain="[('state','=','done')]" />
        <filter name="routine" string="Rutina" domain="[('admission_type','=','routine')]" />
        <filter name="elective" string="Electiva" domain="[('admission_type','=','elective')]" />
        <filter name="urgent" string="Urgente" domain="[('admission_type','=','urgent')]" />
        <filter name="emergency" string="Emergencia" domain="[('admission_type','=','emergency')]" />
        <field name="patient_id" />
        <field name="attending_physician_ids" />
        <field name="name" />
        <field name="ref_physician_id" />
        <field name="relative_id" />
        <field name="ward_id" />
        <field name="bed_id" />
        <separator />
        <group expand="0" string="Group By">
          <filter name="group_by_patient" string="Paciente" context="{'group_by':'patient_id'}" />
          <filter name="group_by_date" string="Fecha" context="{'group_by':'hospitalization_date'}" />
          <filter name="group_by_ward" string="Sala/Habitación" context="{'group_by':'ward_id'}" />
          <filter name="group_by_state" string="Estado" context="{'group_by':'state'}" />
          <filter name="group_by_comp" string="Compañía" context="{'group_by':'company_id'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="view_tgr_inpatient_calendar" model="ir.ui.view">
    <field name="name">tgr.inpatient.calendar</field>
    <field name="model">tgr.hospitalization</field>
    <field name="type">calendar</field>
    <field name="arch" type="xml">
      <calendar string="Hospitalizaciones" color="patient_id" date_start="hospitalization_date"
        date_stop="discharge_date">
        <field name="bed_id" />
        <field name="patient_id" />
        <field name="state" />
      </calendar>
    </field>
  </record>

  <record id="view_hospitalization_pivot" model="ir.ui.view">
    <field name="name">tgr.hospitalization.pivot</field>
    <field name="model">tgr.hospitalization</field>
    <field name="arch" type="xml">
      <pivot string="hospitalizaciones">
        <field name="hospitalization_date" type="row" />
        <field name="department_id" type="row" groups="tgr_hms.group_allow_multi_department" />
        <field name="patient_id" type="row" />
      </pivot>
    </field>
  </record>

  <record model="ir.actions.act_window" id="tgr_action_form_inpatient">
    <field name="name">Hospitalización</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.hospitalization</field>
    <field name="view_mode">list,form,calendar,pivot</field>
    <field name="context">{'search_default_hospitalize': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Haga clic para agregar una nueva hospitalización de paciente.
      </p>
    </field>
  </record>

</odoo>
