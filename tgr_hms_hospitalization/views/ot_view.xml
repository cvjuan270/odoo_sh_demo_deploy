<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_tgr_hospital_ot_list" model="ir.ui.view">
    <field name="name">tgr.hospital.ot.list</field>
    <field name="model">tgr.hospital.ot</field>
    <field name="arch" type="xml">
      <list string="Quirófano del Hospital">
        <field name="name" />
        <field name="building_id" />
        <field name="note" />
      </list>
    </field>
  </record>

  <record id="view_tgr_hospital_ot_form" model="ir.ui.view">
    <field name="name">tgr.hospital.ot.form</field>
    <field name="model">tgr.hospital.ot</field>
    <field name="arch" type="xml">
      <form string="Quirófano del Hospital">
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="building_id" />
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"
                options="{'no_create': True}" />
              <field name="state" required="1" />
              <field name="telephone_number" />
            </group>
          </group>
          <field name="note" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_tgr_hospital_ot_search" model="ir.ui.view">
    <field name="name">tgr.hospital.ot.search</field>
    <field name="model">tgr.hospital.ot</field>
    <field name="arch" type="xml">
      <search string="Quirófano del Hospital">
        <field name="name" />
        <field name="building_id" />
        <field name="note" />
        <filter name="free" string="Libre" domain="[('state','=','free')]" />
        <filter name="reserved" string="Reservado" domain="[('state','=','reserved')]" />
        <filter name="occupied" string="Ocupado" domain="[('state','=','occupied')]" />
        <newline />
        <group expand="0" string="Agrupar Por...">
          <filter name="group_by_building" string="Edificio" domain="[]"
            context="{'group_by':'building_id'}" />
          <filter name="group_by_name" string="Nombre" domain="[]" context="{'group_by':'name'}" />
        </group>
      </search>
    </field>
  </record>

  <record model="ir.actions.act_window" id="act_open_tgr_hospital_ot">
    <field name="name">Quirófano</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.hospital.ot</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Haga clic para agregar un nuevo quirófano del hospital.
      </p>
    </field>
  </record>

</odoo>
