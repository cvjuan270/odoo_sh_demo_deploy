<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tgr_cancel_reason_wiz" model="ir.ui.view">
        <field name="name">tgr.cancel.reason.wiz</field>
        <field name="model">tgr.cancel.reason.wiz</field>
        <field name="arch" type="xml">
            <form string="Cancelar Cita">
                <group>
                    <field name="cancel_reason_id"/>
                    <field name="cancel_reason"/>
                </group>
                <footer>
                    <button name="cancel_appointment" string="Cancelar Cita" type="object" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tgr_cancel_reason_wiz" model="ir.actions.act_window">
        <field name="name">Motivo de Cancelación</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tgr.cancel.reason.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
