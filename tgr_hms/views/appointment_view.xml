<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- Appointment Purpose -->
  <record id="view_appointment_purpose_form_tree" model="ir.ui.view">
    <field name="name">appointment.purpose.tree</field>
    <field name="model">appointment.purpose</field>
    <field name="arch" type="xml">
      <list string="Propósito de Cita">
        <field name="name" />
      </list>
    </field>
  </record>
  <record id="view_appointment_purpose_form_form" model="ir.ui.view">
    <field name="name">appointment.purpose.form.form</field>
    <field name="model">appointment.purpose</field>
    <field name="arch" type="xml">
      <form string="Propósito de Cita">
        <sheet>
          <div class="oe_title">
            <label for="name" string="Nombre" class="oe_edit_only" />
            <h1>
              <field name="name" placeholder="Propósito de Cita" />
            </h1>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="act_open_appointment_purpose" model="ir.actions.act_window">
    <field name="name">Propósito de Cita</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">appointment.purpose</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> No se encontraron registros </p>
      <p> Haga clic para agregar un Propósito de Cita. </p>
    </field>
  </record>
  <!-- Appointment Cabin -->
  <record id="view_appointment_cabin_form_tree" model="ir.ui.view">
    <field name="name">appointment.cabin.tree</field>
    <field name="model">appointment.cabin</field>
    <field name="arch" type="xml">
      <list string="Cabina de Cita">
        <field name="name" />
      </list>
    </field>
  </record>
  <record id="view_appointment_cabin_form_form" model="ir.ui.view">
    <field name="name">appointment.cabin.form.form</field>
    <field name="model">appointment.cabin</field>
    <field name="arch" type="xml">
      <form string="Cabina de Cita">
        <sheet>
          <div class="oe_title">
            <label for="name" string="Nombre" class="oe_edit_only" />
            <h1>
              <field name="name" placeholder="Cabina de Cita" />
            </h1>
          </div>
        </sheet>
      </form>
    </field>
  </record>
  <record id="act_open_appointment_cabin" model="ir.actions.act_window">
    <field name="name">Cabina de Cita</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">appointment.cabin</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> No se encontraron registros </p>
      <p> Haga clic para agregar una Cabina de Cita. </p>
    </field>
  </record>
  <!-- Cancel Reason -->
  <record id="view_tgr_cancel_reason_tree" model="ir.ui.view">
    <field name="name">tgr.cancel.reason.tree</field>
    <field name="model">tgr.cancel.reason</field>
    <field name="arch" type="xml">
      <list string="Motivo de Cancelación" editable="bottom">
        <field name="name" />
      </list>
    </field>
  </record>
  <record id="action_tgr_cancel_reason" model="ir.actions.act_window">
    <field name="name">Motivo de Cancelación</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.cancel.reason</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> No se encontraron registros </p>
      <p> Haga clic para agregar un Motivo de Cancelación. </p>
    </field>
  </record>
  <!-- Appointment -->
  <record model="ir.ui.view" id="appointment_kanban_view">
    <field name="name">appointment.kanban</field>
    <field name="model">hms.appointment</field>
    <field name="type">kanban</field>
    <field name="arch" type="xml">
      <kanban>
        <field name="patient_id" />
        <field name="image_128" />
        <field name="date" />
        <field name="display_name" />
        <field name="state" />
        <field name="physician_id" />
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click o_res_partner_kanban">
              <div class="o_kanban_tags_section oe_kanban_partner_categories" />
              <t t-set="placeholder"
                t-value="'/base/static/img/avatar_grey.png'" />
              <div class="o_kanban_image_fill_left o_kanban_image_full"
                t-attf-style="background-image: url(#{kanban_image('hms.patient', 'image_128', record.patient_id.raw_value, placeholder)})"
                role="img" />
              <div class="oe_kanban_details">
                <strong class="oe_partner_heading">
                  <field name="display_name" />
                </strong>
                <ul>
                  <li t-if="record.patient_id.raw_value">
                    <field name="patient_id" />
                  </li>
                  <li t-if="record.date.raw_value">
                    <field name="physician_id" />
                  </li>
                  <li t-if="record.date.raw_value">
                    <field name="date" />
                  </li>
                </ul>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="view_hms_appointment_tree" model="ir.ui.view">
    <field name="name">hms.appointment.tree</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <list decoration-info="state=='draft'" decoration-muted="state=='cancel'"
        decoration-danger="state=='waiting'" name="appointment_tree">
        <field name="name" />
        <field name="purpose_id" optional="hide" />
        <field name="cabin_id" optional="hide" />
        <field name="patient_id" />
        <field name="date" />
        <field name="department_id"
          groups="tgr_hms.group_allow_multi_department" optional="hide" />
        <field name="physician_id" />
        <field name="responsible_id" optional="hide" />
        <field name="create_uid" optional="hide" />
        <field name="consultation_type" optional="show" />
        <field name="activity_ids" widget="list_activity" optional="show" />
        <field name="invoice_exempt" string="Exento de Factura" optional="hide" />
        <field name="state" optional="show" decoration-info="state=='draft'"
          decoration-muted="state=='cancel'"
          decoration-danger="state=='waiting'"
          decoration-success="state=='done'"
          decoration-primary="state=='in_consultation'"
          decoration-warning="state=='to_invoice'"
          decoration-it="state=='pause'" widget="badge" />
        <field name="waiting_date_start" invisible="1" />
        <field name="waiting_date_end" invisible="1" />
        <field name="date_start" invisible="1" />
        <field name="date_end" invisible="1" />
        <!-- This is options to load fast. Timer read records every-time and it
        takes more loading time So its optional -->
        <field name="waiting_duration_timer" widget="AcsTimer"
          options="{'widget_start_field': 'waiting_date_start', 'widget_stop_field': 'waiting_date_end', 'duration_field': 'waiting_duration_timer'}"
          optional="hide" />
        <field name="company_id" groups="base.group_multi_company"
          optional="hide" />
      </list>
    </field>
  </record>
  <record id="view_hms_appointment_form" model="ir.ui.view">
    <field name="name">hms.appointment.form</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="appointment_confirm" invisible="state!='draft'"
            type="object" groups="tgr_hms.group_hms_receptionist"
            string="Confirmar" class="oe_highlight" />
          <button name="appointment_waiting" invisible="state!='confirm'"
            type="object" groups="tgr_hms.group_hms_receptionist"
            string="En Espera" class="oe_highlight" />
          <button name="print_report" string="Imprimir" type="object"
            invisible="state not in ('draft','confirm')" />
          <button name="action_appointment_send" string="Enviar por Correo"
            type="object" invisible="state not in ('draft','confirm')" />
          <button name="appointment_consultation" invisible="state != 'waiting'"
            groups="tgr_hms.group_hms_jr_doctor" type="object"
            string="En Consulta" class="oe_highlight" />
          <button name="action_pause" invisible="state != 'in_consultation'"
            groups="tgr_hms.group_allow_consultation_pause" type="object"
            string="Pausar" />
          <button name="action_start_paused" invisible="state != 'pause'"
            groups="tgr_hms.group_allow_consultation_pause" type="object"
            string="Reanudar" />
          <button name="button_pres_req" string="Crear Prescripción"
            groups="tgr_hms.group_hms_jr_doctor" type="object"
            invisible="state not in ('in_consultation','invoiced')"
            class="oe_highlight" />
          <button name="create_invoice" string="Crear Factura"
            groups="account.group_account_invoice"
            invisible="not tgr_show_create_invoice" type="object"
            class="oe_highlight" />
          <button name="create_consumed_prod_invoice"
            string="Crear Factura de Consumibles"
            groups="account.group_account_invoice"
            invisible="not tgr_show_conumable_create_invoice" type="object"
            class="oe_highlight" />
          <button name="consultation_done"
            invisible="state != 'in_consultation'"
            groups="tgr_hms.group_hms_jr_doctor" type="object"
            string="Consulta Finalizada" class="oe_highlight" />
          <button name="action_reopen" string="Reabrir"
            groups="tgr_hms.group_hms_allow_update_done_appointment"
            type="object" invisible="state != 'done'" class="oe_highlight" />
          <button name="%(action_tgr_cancel_reason_wiz)d" string="Cancelar"
            invisible="state not in ('draft','confirm','waiting','in_consultation')"
            type="action" />
          <button name="appointment_draft" string="Borrador"
            invisible="state != 'cancel'" type="object" class="oe_highlight" />
          <field name="state" widget="statusbar"
            statusbar_visible="draft,confirm,waiting,in_consultation,done" />
          <field name="appointment_invoice_policy" invisible="1" />
          <field name="consumable_invoice_id" invisible="1" />
          <field name="procedure_to_invoice_ids" invisible="1"
            widget="many2many_tags" />
        </header>
        <div class="alert alert-error text-center" role="alert"
          style="margin-bottom:0px; background-color:#f8b9b9;"
          invisible="alert_count==0">
          <field name="medical_alert_ids" nolabel="1" widget="many2many_tags" />
        </div>
        <sheet>
          <div class="oe_button_box" name="button_box"
            groups="tgr_hms.group_hms_receptionist">
            <button name="action_refer_doctor" string="Refer. To" type="object"
              invisible="state not in ('in_consultation','invoiced')"
              class="oe_stat_button" icon="fa-pencil-square-o" />
            <button name="action_view_treatment" string="Tratamiento"
              type="object" class="oe_stat_button" icon="fa-pencil-square-o"
              invisible="state=='done' and not treatment_id" />
            <button name="action_prescription" string="Prescripción"
              type="object" class="oe_stat_button" icon="fa-pencil-square-o"
              invisible="state=='done' and not prescription_ids" />
            <button class="oe_stat_button" type="object" name="view_invoice"
              icon="fa-pencil-square-o" invisible="invoice_count==0"
              groups="account.group_account_invoice">
              <field string="Facturas" name="invoice_count" widget="statinfo" />
            </button>
            <button name="action_view_patient_procedures" class="oe_stat_button"
              icon="fa-medkit" type="object" string="Procedimientos del Paciente" />
            <field name="prescription_ids" invisible="1" />
            <button class="oe_stat_button" type="object"
              name="action_view_attachments" icon="fa-files-o"
              invisible="attach_count==0">
              <field string="Documentos" name="attach_count" widget="statinfo" />
            </button>
          </div>
          <field name="image_128" widget='image' class="oe_avatar" />
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <!-- Invisible Fields -->
          <field name="tgr_show_create_invoice" invisible="1" />
          <field name="tgr_show_conumable_create_invoice" invisible="1" />
          <field name="invoice_id" invisible="1" />
          <field name="payment_state" invisible="1" />
          <field name="waiting_date_start" invisible="1" />
          <field name="waiting_date_end" invisible="1" />
          <field name="date_start" invisible="1" />
          <field name="date_end" invisible="1" />
          <field name="alert_count" invisible="1" />
          <field name='invoice_exempt' invisible="1" />
          <field name='consumable_line_count' invisible="1" />
          <field name="department_id" invisible="1" />
          <field name="company_id" invisible="1" />
          <field name="reminder_date" invisible="1" />
          <field name="tgr_reminder_sent" invisible="1" />
          <group>
            <group>
              <field name="patient_id" readonly="state in ['cancel','done']" />
              <field name="age" />
              <field name="department_id"
                groups="tgr_hms.group_allow_multi_department"
                readonly="state in ['cancel','done']" />
              <field name="department_type" invisible="1"
                readonly="state in ['cancel','done']" />
              <field name="physician_id" required="1"
                readonly="state in ['cancel','done']" />
              <field name="follow_date"
                invisible="state not in ('in_consultation','done','to_invoice')"
                readonly="state in ['cancel','done']" />
            </group>
            <group>
              <label for="date" string="Fecha" />
              <div class="o_row">
                <field name="date" widget="daterange" nolabel="1"
                  class="oe_inline" options="{'related_end_date': 'date_to'}"
                  readonly="state!='draft'" />
                <i class="fa fa-long-arrow-right mx-2" aria-label="Icono de flecha"
                  title="Flecha" />
                <field name="date_to" widget="daterange" nolabel="1"
                  class="oe_inline" options="{'related_start_date': 'date'}"
                  readonly="state!='draft'" />
              </div>
              <field name="planned_duration" widget="float_time"
                readonly="state!='draft'" />
            </group>
          </group>
          <notebook>
            <page name="info" string="Información General">
              <group>
                <group>
                  <field name="nurse_id" readonly="state in ['cancel','done']" />
                  <field name="product_id" required="1"
                    context="{'default_detailed_type':'service','default_hospital_product_type':'consultation'}"
                    readonly="state in ['cancel','done']" />
                  <field name="cabin_id" readonly="state in ['cancel','done']" />
                  <field name="diseases_ids" widget="many2many_tags"
                    groups="tgr_hms.group_hms_nurse"
                    readonly="state in ['cancel','done']" />
                  <field name="responsible_id"
                    readonly="state in ['cancel','done']" />
                </group>
                <group>
                  <field name="urgency" readonly="state in ['cancel','done']" />
                  <field name="purpose_id" readonly="state in ['cancel','done']" />
                  <field name="outside_appointment"
                    readonly="state in ['cancel','done']" />
                  <field name="location" widget="url"
                    invisible="not outside_appointment"
                    readonly="state in ['cancel','done']" />
                  <field name="is_video_call"
                    readonly="state in ['cancel','done']" />
                </group>
              </group>
              <separator string="Motivo de Consulta" name="chief_complain" />
              <field name="chief_complain" placeholder="Motivo de Consulta..."
                readonly="state in ['cancel','done']" />
              <separator name="present_illness"
                string="Historia de la Enfermedad Actual"
                groups="tgr_hms.group_hms_nurse" />
              <field name="present_illness"
                placeholder="Historia de la Enfermedad Actual..."
                groups="tgr_hms.group_hms_nurse"
                readonly="state in ['cancel','done']" />
              <separator name="past_history" string="Historia Pasada"
                groups="tgr_hms.group_hms_nurse" />
              <field name="past_history" placeholder="Historia Pasada..."
                groups="tgr_hms.group_hms_nurse"
                readonly="state in ['cancel','done']" />
              <separator string="Motivo de Cancelación" name="tgr_cancel_reason"
                invisible="state!='cancel'" />
              <group name="cancale_reason">
                <field name="cancel_reason_id" invisible="state!='cancel'"
                  readonly="state in ['cancel','done']" />
              </group>
              <field name="cancel_reason" placeholder="Motivo de Cancelación..."
                invisible="state!='cancel'"
                readonly="state in ['cancel','done']" />
            </page>
            <page name="clinical_ass" string="Evaluación Clínica"
              groups="tgr_hms.group_hms_nurse" invisible="state=='draft'">
              <div>NOTA: Los detalles se muestran según la Evaluación del Paciente. <t
                  invisible="not evaluation_id">Última Evaluación: <field
                    name="evaluation_id" nolabel="1" class="oe_link" /></t>
                                <t
                  invisible="evaluation_id">
                  <button name="action_create_evaluation" type="object"
                    string="Crear Evaluación" class=" oe_link" />
                </t>
              </div>
              <group>
                <group>
                  <label for="weight" />
                  <div class="o_row">
                    <field name="weight" />
                    <field name="tgr_weight_name" />
                  </div>
                  <label for="height" />
                  <div class="o_row">
                    <field name="height" />
                    <field name="tgr_height_name" />
                  </div>
                  <label for="temp" />
                  <div class="o_row">
                    <field name="temp" />
                    <field name="tgr_temp_name" />
                  </div>
                  <field name="hr" />
                </group>
                <group>
                  <field name="rr" />
                  <label string="PA Sistólica/Diastólica" for="systolic_bp" />
                  <div name="systolic_bp">
                    <div class="oe_inline" style="display: inline;">
                      <field name="systolic_bp" class="oe_inline" />/<field
                        name="diastolic_bp" class="oe_inline" />
                    </div>
                  </div>
                  <label for="spo2" />
                  <div class="o_row">
                    <field name="spo2" />
                    <field name="tgr_spo2_name" />
                  </div>
                  <label for="rbs" />
                  <div class="o_row">
                    <field name="rbs" />
                    <field name="tgr_rbs_name" />
                  </div>
                </group>
                <group>
                  <field name="bmi" />
                </group>
                <group>
                  <field name="bmi_state" />
                </group>
                <separator string="Nivel de Dolor" />
                <group>
                  <group>
                    <label for="pain_level" />
                    <div class="o_row">
                      <field name="pain_level" />
                      <span>
                        <button name="%(action_tgr_pain_level)d" type="action"
                          icon="fa-question-circle" title="Nivel de Dolor" />
                      </span>
                    </div>
                    <field name="pain" colspan="2" nolabel="1" />
                  </group>
                </group>
              </group>
              <separator string="Laboratorio" name="lab_report" />
              <field name="lab_report" placeholder="Informe de Laboratorio..."
                readonly="state in ['cancel','done']" />
              <separator string="Radiológico" name="radiological_report" />
              <field name="radiological_report"
                placeholder="Informe Radiológico..."
                readonly="state in ['cancel','done']" />
            </page>
            <page name="advice" string="D/D y Consejos"
              groups="tgr_hms.group_hms_jr_doctor,tgr_hms.group_tgr_hms_appointment_user"
              invisible="state=='draft'">
              <separator string="Diagnóstico Diferencial"
                name="differencial_diagnosis" />
              <field name="differencial_diagnosis"
                placeholder="Diagnóstico Diferencial..."
                readonly="state in ['cancel','done']" />
              <separator string="Consejo Médico" name="medical_advice" />
              <field name="medical_advice" placeholder="Consejo Médico..."
                readonly="state in ['cancel','done']" />
            </page>
            <page name='diseases' string="Historial de Enfermedades"
              groups="tgr_hms.group_hms_jr_doctor" invisible="state=='draft'">
              <separator string="Historia Médica Pasada" name="medical_history" />
              <field name="medical_history"
                readonly="state in ['cancel','done']" />
              <separator string="Historial de Enfermedades" name="patient_diseases_ids" />
              <field name="patient_diseases_ids"
                readonly="state in ['cancel','done']" />
            </page>
            <page name="consumed_products" string="Productos/Servicios Consumidos"
              groups="tgr_hms.group_hms_jr_doctor,tgr_hms.group_tgr_hms_appointment_user"
              invisible="state=='draft'">
              <label for="tgr_kit_id" invisible="state in ('done','cancel')" />
              <div name="tgr_kit_id" invisible="state in ('done','cancel')">
                <field name="tgr_kit_id" nolabel="1"
                  options="{'no_create': True}" />
                <field name="tgr_kit_qty" class="oe_inline" nolabel="1"
                  invisible="not tgr_kit_id" />
                <button name="get_tgr_kit_lines" string="Agregar Productos de Kit"
                  type="object" class="oe_inline fa fa-arrow-right oe_link"
                  invisible="not tgr_kit_id" />
              </div>
              <field name="pricelist_id" invisible="1" />
              <field name="consumable_line_ids" nolabel="1" colspan="4"
                context="{'default_patient_id': patient_id, 'default_department_id': department_id, 'default_physician_id': physician_id, 'default_pricelist_id': pricelist_id}"
                readonly="state in ['cancel','done']">
                <list string="Línea" editable="top">
                  <field name="product_id" expand="1" required="1" />
                  <field name="product_uom_id" required="1"
                    groups="uom.group_uom" />
                  <field name="qty" required="1" />
                  <field name="lot_id" context="{'tgr_product_id': product_id}"
                    options="{'no_create': True}" readonly="tracking=='none'"
                    required="tracking!='none'" />
                  <field name="price_unit" readonly="1" force_save="1" />
                  <field name="subtotal" readonly="1" sum="Total"
                    optional="show" />
                  <field name="date" required="1" />
                  <field name="note" />
                  <field name="tracking" column_invisible="1" />
                  <field name="product_uom_category_id" column_invisible="1" />
                  <field name="pricelist_id" column_invisible="1" />
                  <field name="move_id" column_invisible="1" />
                  <field name="physician_id" column_invisible="1" />
                  <field name="department_id" column_invisible="1" />
                  <field name="patient_id" column_invisible="1" />
                </list>
              </field>
            </page>
            <page name="other_info" string="Otra Información"
              groups="tgr_hms.group_hms_receptionist">
              <group name="extra_info">
                <group>
                  <field name="waiting_duration_timer" widget="AcsTimer"
                    invisible="state!='waiting'"
                    options="{'widget_start_field': 'waiting_date_start', 'widget_stop_field': 'waiting_date_end', 'duration_field': 'waiting_duration_timer'}" />
                  <field name="waiting_duration" invisible="state=='waiting'"
                    widget="float_time" />
                  <field name="pause_duration" widget="float_time"
                    invisible="pause_duration==0" />
                </group>
                <group>
                  <field name="appointment_duration_timer" widget="AcsTimer"
                    invisible="state!='in_consultation'"
                    options="{'widget_start_field': 'date_start', 'widget_stop_field': 'date_end', 'duration_field': 'appointment_duration_timer'}" />
                  <field name="appointment_duration" widget="float_time"
                    invisible="state=='in_consultation'" />
                </group>
                <group>
                  <field name="treatment_id"
                    domain="[('patient_id','=', patient_id)]"
                    context="{'default_patient_id': patient_id, 'default_department_id': department_id, 'default_physician_id': physician_id}"
                    readonly="state in ['cancel','done']" />
                  <field name="ref_physician_id"
                    readonly="state in ['cancel','done']" />
                  <label for="invoice_exempt" />
                  <div name='invoice_exemption'>
                    <field name='invoice_exempt' class="oe_inline" nolabel="1"
                      readonly="1" />
                    <button name="tgr_apply_invoice_exemption"
                      string="Aplicar/Eliminar" type="object"
                      class="oe_inline fa fa-arrow-right oe_link"
                      invisible="invoice_id"
                      groups="tgr_hms_base.group_tgr_invoice_exemption" />
                  </div>
                  <field name="refer_reason"
                    readonly="state in ['cancel','done']" />
                  <field name="refered_from_appointment_id"
                    invisible="not refered_from_appointment_id" readonly="1"
                    force_save="1" />
                  <field name="refered_from_physician_id"
                    invisible="not refered_from_appointment_id"
                    readonly="state in ['cancel','done']" />
                  <field name="refered_from_reason"
                    invisible="not refered_from_appointment_id"
                    readonly="state in ['cancel','done']" />
                  <field name="refered_to_appointment_id"
                    invisible="not refered_to_appointment_id" readonly="1"
                    force_save="1" />
                  <field name="refered_to_physician_id"
                    invisible="not refered_to_appointment_id"
                    readonly="state in ['cancel','done']" />
                </group>
                <group>
                  <field name="consultation_type"
                    readonly="state in ['cancel','done']" />
                  <field name="product_id" required="1"
                    context="{'default_detailed_type':'service','default_hospital_product_type':'consultation'}"
                    readonly="state in ['cancel','done']" />
                  <field name="pricelist_id"
                    groups="product.group_product_pricelist"
                    options="{'no_open':True,'no_create': True}"
                    readonly="state in ['cancel','done']" />
                  <field name="user_id" widget="many2one_avatar_user"
                    readonly="state in ['cancel','done']" />
                  <field name="company_id" groups="base.group_multi_company"
                    options="{'no_create': True}"
                    readonly="state in ['cancel','done']" />
                </group>
              </group>
            </page>
          </notebook>
          <separator string="Notas" />
          <field name="notes" placeholder="Notas..." />
        </sheet>
        <chatter></chatter>
      </form>
    </field>
  </record>
  <record id="view_hms_appointment_search" model="ir.ui.view">
    <field name="name">Appointment Search</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <search string="Buscar Citas">
        <field name="name" />
        <field name="patient_id" />
        <field name="physician_id" />
        <field name="purpose_id" />
        <field name="cabin_id" />
        <field name="treatment_id" />
        <field name="department_id"
          groups="tgr_hms.group_allow_multi_department" />
        <field name="ref_physician_id" />
        <filter name="today" string="Hoy"
          domain="[('date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]" />
        <filter name="my_app" string="Mis Citas"
          domain="[('physician_id.user_id', '=',uid)]" />
        <filter name="urgency" string="Cita Urgente"
          domain="[('urgency','=','urgent')]" />
        <filter name="urgency" string="Emergencia Médica"
          domain="[('urgency','=','medical_emergency')]" />
        <filter name="consultation" string="Cita de Consulta"
          domain="[('consultation_type','=','consultation')]" />
        <filter name="consultation" string="Cita de Seguimiento"
          domain="[('consultation_type','=','followup')]" />
        <separator />
        <filter name="done" string="No Finalizado" domain="[('state','!=','done')]" />
        <group expand="0" string="Agrupar Por...">
          <filter string="Paciente" name="patient_groupby" domain="[]"
            context="{'group_by':'patient_id'}" />
          <filter string="Médico" name="physician_groupby" domain="[]"
            context="{'group_by':'physician_id'}" />
          <filter string="Fecha" name="date_groupby" domain="[]"
            context="{'group_by':'date'}" />
          <filter string="Estado" name="state_groupby" domain="[]"
            context="{'group_by':'state'}" />
          <filter string="Propósito" name="purpose_groupby" domain="[]"
            context="{'group_by':'purpose_id'}" />
          <filter string="Departamento" name="department_groupby" domain="[]"
            context="{'group_by':'department_id'}" />
          <filter string="Médico Referente" name="ref_physician_groupby"
            domain="[]" context="{'group_by':'ref_physician_id'}" />
        </group>
      </search>
    </field>
  </record>
  <record id="view_tgr_appointment_calendar" model="ir.ui.view">
    <field name="name">hms.appointment.calendar</field>
    <field name="model">hms.appointment</field>
    <field name="type">calendar</field>
    <field name="arch" type="xml">
      <calendar string="Citas" color="state" date_start="date"
        quick_create="0" date_stop="date_to">
        <field name="physician_id" />
        <field name="patient_id" />
        <field name="age" />
        <field name="medical_alert_ids" widget="many2many_tags" />
        <field name="state" filters="1" />
        <field name="physician_id" avatar_field="image_128" />
      </calendar>
    </field>
  </record>
  <record id="view_appointment_pivot" model="ir.ui.view">
    <field name="name">hms.appointment.pivot</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <pivot string="Citas">
        <field name="date" type="row" />
        <field name="physician_id" type="row" />
        <field name="patient_id" type="row" />
        <field name="waiting_duration" type="measure" />
        <field name="appointment_duration" type="measure" />
      </pivot>
    </field>
  </record>
  <record id="view_appointment_graph" model="ir.ui.view">
    <field name="name">hms.appointment.graph</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <graph string="Citas" type="line">
        <field name="physician_id" />
        <field name="appointment_duration" type="measure" />
      </graph>
    </field>
  </record>
  <record id="view_appointment_activity" model="ir.ui.view">
    <field name="name">hms.appointment.activity</field>
    <field name="model">hms.appointment</field>
    <field name="arch" type="xml">
      <activity string="Citas">
        <templates>
          <div t-name="activity-box">
            <div>
              <field name="name" display="full" />
              <field name="patient_id" muted="1" display="full" />
            </div>
          </div>
        </templates>
      </activity>
    </field>
  </record>
  <record id="action_appointment" model="ir.actions.act_window">
    <field name="name">Cita</field>
    <field name="res_model">hms.appointment</field>
    <field name="view_mode">list,form,kanban,calendar,pivot,graph,activity</field>
    <field name="context">{'search_default_today': 1,'search_default_done': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> No se encontraron registros </p>
      <p> Haga clic para agregar una Cita. </p>
    </field>
  </record>
</odoo>
