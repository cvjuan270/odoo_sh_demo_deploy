<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_hms_patient_medication_tree" model="ir.ui.view">
    <field name="name">hms.patient.medication.tree</field>
    <field name="model">hms.patient.medication</field>
    <field name="arch" type="xml">
      <list string="Medicación del Paciente">
        <field name="patient_id" />
        <field name="physician_id" />
        <field name="adverse_reaction" />
        <field name="notes" />
        <field name="is_active" />
        <field name="course_completed" />
        <field name="product_id" />
        <field name="discontinued_reason" />
        <field name="discontinued" />
      </list>
    </field>
  </record>
  <record id="view_hms_patient_medication_form" model="ir.ui.view">
    <field name="name">hms.patient.medication.form</field>
    <field name="model">hms.patient.medication</field>
    <field name="arch" type="xml">
      <form string="Medicación del Paciente">
        <field name="patient_id" />
        <field name="physician_id" />
        <field name="adverse_reaction" />
        <field name="notes" />
        <field name="is_active" />
        <field name="course_completed" />
        <field name="product_id" />
        <field name="discontinued_reason" />
        <field name="discontinued" />
      </form>
    </field>
  </record>
  <record id="view_hms_patient_medication_search" model="ir.ui.view">
    <field name="name">hms.patient.medication.search</field>
    <field name="model">hms.patient.medication</field>
    <field name="arch" type="xml">
      <search string="Medicación del Paciente">
        <field name="patient_id" />
        <field name="physician_id" />
        <field name="adverse_reaction" />
        <field name="notes" />
        <field name="is_active" />
        <field name="course_completed" />
        <field name="product_id" />
        <field name="discontinued_reason" />
        <field name="discontinued" />
        <newline />
        <group expand="0" string="Agrupar Por...">
          <filter string="Paciente" name="patient_id_groupby" domain="[]"
            context="{'group_by':'patient_id'}" />
          <filter string="Médico" name="doctor_groupby" domain="[]"
            context="{'group_by':'physician_id'}" />
          <filter string="Reacciones Adversas" name="adverse_reaction_groupby"
            domain="[]" context="{'group_by':'adverse_reaction'}" />
          <filter string="Información Adicional" name="notes_groupby" domain="[]"
            context="{'group_by':'notes'}" />
          <filter string="Activo" name="is_active_groupby" domain="[]"
            context="{'group_by':'is_active'}" />
          <filter string="Curso Completado" name="course_completed_groupby"
            domain="[]" context="{'group_by':'course_completed'}" />
          <filter string="Producto Medicamentoso" name="product_id_groupby"
            domain="[]" context="{'group_by':'product_id'}" />
          <filter string="Razón de Discontinuación"
            name="discontinued_reason_groupby" domain="[]"
            context="{'group_by':'discontinued_reason'}" />
          <filter string="Descontinuado" name="discontinued_groupby" domain="[]"
            context="{'group_by':'discontinued'}" />
        </group>
      </search>
    </field>
  </record>
  <record model="ir.actions.act_window"
    id="act_open_hms_patient_medication_view">
    <field name="name">Medicación del Paciente</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">hms.patient.medication</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_hms_patient_medication_search" />
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>
