<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_medical_alert_tree" model="ir.ui.view">
    <field name="name">tgr.medical.alert.tree</field>
    <field name="model">tgr.medical.alert</field>
    <field name="arch" type="xml">
      <list string="Alerta Médica">
        <field name="name" />
      </list>
    </field>
  </record>
  <record id="view_medical_alert_form" model="ir.ui.view">
    <field name="name">tgr.medical.alert.form</field>
    <field name="model">tgr.medical.alert</field>
    <field name="arch" type="xml">
      <form string="Alertas Médicas">
        <sheet>
          <div class="oe_title">
            <label for="name" string="Nombre" class="oe_edit_only" />
            <h1>
              <field name="name" placeholder="Alerta Médica" />
            </h1>
          </div>
          <separator string="Descripción" />
          <field name="description" />
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_medical_alert_search" model="ir.ui.view">
    <field name="name">tgr.medical.alert.search</field>
    <field name="model">tgr.medical.alert</field>
    <field name="arch" type="xml">
      <search string="Alerta Médica">
        <field name="name" />
      </search>
    </field>
  </record>
  <record model="ir.actions.act_window" id="act_open_medical_alerts">
    <field name="name">Alertas Médicas</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">tgr.medical.alert</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face"> No se encontraron registros </p>
      <p> Haga clic para agregar una Alerta Médica. </p>
    </field>
  </record>
</odoo>
