<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_tgr_lab_test_document_details" inherit_id="tgr_laboratory.report_lab_results_document">
        <xpath expr="//div[@name='signature']" position="before">
            <div t-if="o.appointment_id" class="col-auto col-3 mw-100 mb-2">
                <strong>Appointment:</strong>
                <p class="m-0" t-field="o.appointment_id"/>
            </div>
        </xpath>
    </template>

</odoo>